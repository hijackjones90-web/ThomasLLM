# Vertex AI Custom Training Dockerfile for ThomasVLM
# Build: docker build -f Dockerfile.vertex -t gcr.io/PROJECT_ID/thomasvlm:latest .
# Push:  docker push gcr.io/PROJECT_ID/thomasvlm:latest

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1

# Install Python 3.11 and system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-dev \
    git curl wget \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Symlink python3.11 -> python3
RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python

# Upgrade pip and install build deps
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.1 support first
RUN pip install --no-cache-dir \
    torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cu121

# Install ML dependencies
RUN pip install --no-cache-dir \
    transformers==4.51.3 \
    datasets==3.2.0 \
    peft==0.14.0 \
    safetensors==2.20.0 \
    Pillow==10.3.0 \
    numpy==1.26.4 \
    matplotlib==3.8.0 \
    huggingface_hub==1.3.3 \
    sentencepiece==0.1.8 \
    accelerate==0.30.0 \
    bitsandbytes==1.20.0 \
    sacrebleu==2.30.0 \
    yaml==0.2.5 \
    tensorboard==2.17.0

# Copy the ThomasVLM package
WORKDIR /workspace
COPY thomasllm/ ./thomasllm/
COPY run_all.sh .

# Make run_all.sh executable
RUN chmod +x run_all.sh

# Install the package in development mode
RUN pip install -e ./thomasllm

# Create directories for data and checkpoints
RUN mkdir -p /workspace/data/cache /workspace/checkpoints/stage1 /workspace/checkpoints/stage2 /workspace/app/thomasllm/eval /workspace/app/thomasllm/samples /artifacts/thomasvlm

# Set PYTHONPATH
ENV PYTHONPATH=/workspace:/workspace/thomasllm:$PYTHONPATH

# Default command (can be overridden by Vertex AI)
ENTRYPOINT ["python", "-m", "thomasllm.run.vertex_entry"]